# ==============================================================================
# Supabase Configuration (Free Tier)
# Get these from your Supabase Dashboard: Project Settings -> API
# ==============================================================================

# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Project Anon Public API Key (starts with eyJhbGciOi...)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Default Family List ID (defaults to 'family-main' if not set)
VITE_DEFAULT_LIST_ID=family-main
